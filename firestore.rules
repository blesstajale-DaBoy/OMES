rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTeacher(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.position is string && data.position.size() <= 100 &&
             data.department is string && data.department.size() <= 100;
    }

    function isValidSupervisor(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.position is string && data.position.size() <= 100 &&
             data.department is string && data.department.size() <= 100;
    }

    function isValidObservation(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.teacherId is string && data.teacherId.size() <= 64 &&
             data.supervisorId is string && data.supervisorId.size() <= 64;
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if isValidId(teacherId);
      allow create, update: if isValidId(teacherId) && isValidTeacher(request.resource.data);
      allow delete: if isValidId(teacherId);
    }

    // Supervisors collection
    match /supervisors/{supervisorId} {
      allow read: if isValidId(supervisorId);
      allow create, update: if isValidId(supervisorId) && isValidSupervisor(request.resource.data);
      allow delete: if isValidId(supervisorId);
    }

    // Observations collection
    match /observations/{observationId} {
      allow read: if isValidId(observationId);
      allow create, update: if isValidId(observationId) && isValidObservation(request.resource.data);
      allow delete: if isValidId(observationId);
    }

    // App state & sync collections (school profile, settings, records)
    match /schoolProfile/{profileId} {
      allow read: if isValidId(profileId);
      allow write: if isValidId(profileId);
    }

    match /appData/{docId} {
      allow read: if isValidId(docId);
      allow write: if isValidId(docId);
    }

    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
